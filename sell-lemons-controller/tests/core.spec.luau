local c={}
require('../src/config')(c)
require('../src/core/Numeric')(c)
require('../src/data/Catalogue')(c)
require('../src/core/HaloPlanner')(c)
require('../src/core/EconomyPlanner')(c)
require('../src/core/ObservationStore')(c)
require('../src/core/RecoveryPolicy')(c)
local passed=0
local function check(name,fn)
    local ok,err=pcall(fn);assert(ok,name..': '..tostring(err));passed=passed+1
end
local B=c.Core.BN
check('catalogue preserved',function() assert(#c.HaloCatalogue==452 and c.HaloCatalogue[452].name=='The End') end)
check('large values stay finite',function()
    local n=B.mul(B.new(8,244),4);assert(n.m==3.2 and n.e==245)
    assert(B.cmp(B.add(B.new(1,240),B.new(1,239)),B.new(1.1,240))==0)
end)
check('purchase reserve is not income',function()
    local gain=c.Planner.netInvestorGain({investors=B.new(100),reward=B.new(100),perInvestor=.08},B.new(100))
    assert(gain==1)
end)
check('hidden initial data is unknown',function()
    local time=10;local s=c.ObservationStore.new(function()return time end)
    s:observe('evo',{pct=20},'20',false)
    assert(s:read('evo',10)==nil and s:read('evo',10,true)==nil)
    time=11;s:observe('evo',{pct=21},'21',false)
    assert(s:read('evo',10).pct==21 and s:read('evo',10,true)==nil)
end)
check('unchanged hidden data cannot renew its age',function()
    local time=10;local s=c.ObservationStore.new(function()return time end)
    s:observe('inv',{},'100',true);time=20;s:observe('inv',{},'100',false)
    assert(s:read('inv',2)==nil)
    assert(s:summary().channels.inv.age==10)
end)
check('hidden changes invalidate previous visible transaction evidence',function()
    local time=10;local s=c.ObservationStore.new(function()return time end)
    s:observe('inv',{},'100',true);time=10.1;s:observe('inv',{},'101',false)
    assert(s:read('inv',2)~=nil and s:read('inv',2,true)==nil)
end)
check('reset invalidates all snapshots',function()
    local s=c.ObservationStore.new(function()return 10 end)
    s:observe('inv',{},'100',true);s:invalidate('evolution')
    assert(s:read('inv',2)==nil and s.generation==1)
end)
check('clock reversal cannot make data fresh',function()
    local time=10;local s=c.ObservationStore.new(function()return time end)
    s:observe('inv',{},'100',true);time=9;assert(s:read('inv',2)==nil)
end)
check('missing view recovery is bounded',function()
    for i=0,3 do assert(c.RecoveryPolicy.schedule('PASS_VIEW_NOT_READY',i,10).attempt==i+1) end
    assert(c.RecoveryPolicy.schedule('PASS_VIEW_NOT_READY',4,10)==nil)
end)
check('manual stop and unknown receipts never auto-resume',function()
    for _,code in ipairs({'PAUSED','RUNTIME_ERROR','BUY_FAILED','CALLBACK_STILL_PENDING','UNLOADED'}) do
        assert(c.RecoveryPolicy.schedule(code,0,10)==nil)
    end
end)
check('small purchases do not starve review',function()
    assert(c.RecoveryPolicy.reviewDue(46,'UPGRADE','PREPARE',false,false,true))
    assert(not c.RecoveryPolicy.reviewDue(44,'UPGRADE','PREPARE',false,false,true))
end)
check('finish, pending reset and rebuild keep their boundaries',function()
    assert(not c.RecoveryPolicy.reviewDue(90,'BUY','FINISH',false,false,true))
    assert(not c.RecoveryPolicy.reviewDue(90,'BUY','PREPARE',true,false,true))
    assert(not c.RecoveryPolicy.reviewDue(90,'UPGRADE','PREPARE',false,true,true))
    assert(not c.RecoveryPolicy.reviewDue(90,'UPGRADE','PREPARE',false,false,false))
end)
print('PASS '..passed..' core scenarios')
